# Application
NODE_ENV=production
PORT=4000
CORS_ORIGINS=https://blackend.duanfukeji.com

# Database — PostgreSQL for production, SQLite for dev
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=xcai
# true = 启动时自动同步数据库 schema（首次部署必须为 true）
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Redis
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Storage — local / minio / oss
STORAGE_TYPE=minio

# MinIO 配置
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=xcai
MINIO_USE_SSL=false

# 本地存储（STORAGE_TYPE=local 时使用）
STORAGE_LOCAL_PATH=data/uploads

# 阿里云 OSS（STORAGE_TYPE=oss 时使用）
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=xcai
OSS_ENDPOINT=
OSS_CDN_DOMAIN=

# JWT
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMS — mock (打印到控制台) 或 market (阿里云市场)
SMS_PROVIDER=mock
SMS_APP_CODE=
SMS_TEMPLATE_ID=
SMS_MARKET_HOST=send.market.alicloudapi.com
SMS_MARKET_PATH=/sms/send
SMS_CODE_LENGTH=6
SMS_CODE_TTL=300
SMS_CODE_COOLDOWN=60
SMS_MAX_SEND_PER_DAY=10

# Real-Name Verification
REAL_NAME_APP_CODE=
REAL_NAME_VERIFY_HOST=zidv2.market.alicloudapi.com
REAL_NAME_VERIFY_PATH=/idcheck/Post

# WeChat
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# QQ
QQ_APP_ID=
QQ_APP_KEY=

# APP 热更新版本（服务端控制，高于 APP buildNumber 时触发更新提示）
APP_VERSION=1.0.0
APP_VERSION_CODE=1
APP_DOWNLOAD_URL=https://your-domain.com/dist/app-release.apk
APP_CHANGELOG=初始版本
APP_FORCE_UPDATE=false
