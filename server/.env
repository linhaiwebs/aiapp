# Application
NODE_ENV=production
PORT=4000
CORS_ORIGINS=https://blackend.duanfukeji.com,https://admin.blackend.duanfukeji.com

# Database - PostgreSQL for production
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=xcai
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Redis - Enabled for production
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Storage - MinIO for production
STORAGE_TYPE=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=xcai
MINIO_USE_SSL=false

# JWT
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMS (Aliyun / MCP)
SMS_PROVIDER=mcp
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_MCP_URL=http://mcpservergateway.market.alicloudapi.com/mcpnacos/cmapi00067513/eyJhcHBDb2RlIjoiZjJiMDczNjBjMWEwNDgwNWE1YjNjYzkzNjdiNDUxNDEiLCJzIjoiQ2xvdWRfTWFya2V0In0=/sse
SMS_MCP_TEMPLATE_ID=lxym_20111_sdgsfhwqgvyh
SMS_CODE_LENGTH=6
SMS_CODE_TTL=300
SMS_CODE_COOLDOWN=60
SMS_MAX_SEND_PER_DAY=10

# Real-Name Verification
REAL_NAME_MCP_URL=http://mcpservergateway.market.alicloudapi.com/mcpnacos/cmapi00037894/eyJhcHBDb2RlIjoiZjJiMDczNjBjMWEwNDgwNWE1YjNjYzkzNjdiNDUxNDEiLCJzIjoiQ2xvdWRfTWFya2V0In0=/sse

# WeChat
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# QQ
QQ_APP_ID=
QQ_APP_KEY=
