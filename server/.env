# Application
NODE_ENV=production
PORT=4000
CORS_ORIGINS=https://blackend.duanfukeji.com,https://admin.blackend.duanfukeji.com

# Database - PostgreSQL for production
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=xcai
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Redis - Enabled for production
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Storage - MinIO for production
STORAGE_TYPE=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=xcai
MINIO_USE_SSL=false

# JWT
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMS — 阿里云市场短信服务 (cmapi00067513)
SMS_PROVIDER=market
SMS_APP_CODE=f2b07360c1a04805a5b3cc9367b45141
SMS_TEMPLATE_ID=lxym_20111_sdgsfhwqgvyh
SMS_MARKET_HOST=smsapi.market.alicloudapi.com
SMS_MARKET_PATH=/sms/send
SMS_CODE_LENGTH=6
SMS_CODE_TTL=300
SMS_CODE_COOLDOWN=60
SMS_MAX_SEND_PER_DAY=10

# Real-Name Verification
REAL_NAME_MCP_URL=http://mcpservergateway.market.alicloudapi.com/mcpnacos/cmapi00037894/eyJhcHBDb2RlIjoiZjJiMDczNjBjMWEwNDgwNWE1YjNjYzkzNjdiNDUxNDEiLCJzIjoiQ2xvdWRfTWFya2V0In0=/sse

