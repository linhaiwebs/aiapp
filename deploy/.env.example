# ============================================================
# XCAI 端云智采 - Docker 部署环境配置
# 复制此文件为 .env 后根据实际情况修改
# cp .env.example .env
# ============================================================

# ===== 端口配置（支持自定义端口）=====
# ┌──────────────────────────────────────────────────────┐
# │ 如果服务器已有 Nginx（宝塔等），推荐使用：              │
# │   docker-compose.host-nginx.yml                     │
# │ 只需配置 SERVER_PORT，由宿主机 Nginx 反向代理         │
# │                                                      │
# │ 如果服务器没有 Nginx，使用：                           │
# │   docker-compose.yml（含 Docker 内 Nginx）            │
# │ 需要配置 NGINX_HTTP_PORT / NGINX_HTTPS_PORT          │
# └──────────────────────────────────────────────────────┘

# 宿主机 Nginx 模式：只需配置此端口
# 后端 API 端口，宿主机 Nginx 反向代理到此端口
SERVER_PORT=3000

# Docker 内 Nginx 模式：配置对外端口（host-nginx 模式可忽略）
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# 以下端口一般不需要暴露到宿主机（留空则不映射）
POSTGRES_PORT=
REDIS_PORT=
MINIO_API_PORT=
MINIO_CONSOLE_PORT=

# ===== 数据库配置 =====
DB_TYPE=postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=xcai
# ⚠️ 首次部署必须为 true，让 TypeORM 自动创建数据库表
# 表创建完成后可改为 false 提升性能
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ===== Redis 配置 =====
REDIS_ENABLED=true
REDIS_PASSWORD=

# ===== 存储配置 =====
# minio 或 local（Docker 部署推荐 minio）
STORAGE_TYPE=minio
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=xcai
MINIO_USE_SSL=false

# ===== JWT 安全配置 =====
# ⚠️ 生产环境务必修改为随机长字符串！
# 可用: openssl rand -base64 48
JWT_SECRET=change-this-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== CORS 跨域配置 =====
# 允许的前端域名，多个用逗号分隔
CORS_ORIGINS=https://blackend.duanfukeji.com,https://admin.blackend.duanfukeji.com

# ===== 短信配置 =====
# mock = 不发真短信（开发/测试用）
# aliyun = 阿里云短信
SMS_PROVIDER=mcp
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
