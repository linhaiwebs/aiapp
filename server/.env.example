# Application
NODE_ENV=production
PORT=4000
CORS_ORIGINS=https://your-domain.com

# Database — PostgreSQL for production, SQLite for dev
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=xcai
# true = 启动时自动同步数据库 schema（首次部署必须为 true）
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Redis
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Storage — minio or local
STORAGE_TYPE=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=xcai
MINIO_USE_SSL=false

# JWT
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMS — mock (打印到控制台) 或 market (阿里云市场)
SMS_PROVIDER=mock
SMS_APP_CODE=
SMS_TEMPLATE_ID=
SMS_MARKET_HOST=send.market.alicloudapi.com
SMS_MARKET_PATH=/sms/send
SMS_CODE_LENGTH=6
SMS_CODE_TTL=300
SMS_CODE_COOLDOWN=60
SMS_MAX_SEND_PER_DAY=10

# Real-Name Verification
REAL_NAME_APP_CODE=
REAL_NAME_VERIFY_HOST=zidv2.market.alicloudapi.com
REAL_NAME_VERIFY_PATH=/idcheck/Post

# WeChat
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# QQ
QQ_APP_ID=
QQ_APP_KEY=
