# Application
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:8000,http://localhost:5173

# Database - Development uses SQLite, Production uses PostgreSQL
# DB_TYPE=sqlite          # default in development
# DB_SQLITE_PATH=data/xcai.db  # default SQLite path
# For PostgreSQL:
# DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=xcai
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Redis - Disabled by default in development
# REDIS_ENABLED=true      # enable for production
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Storage - Development uses local filesystem, Production uses MinIO
# STORAGE_TYPE=local      # default in development
# STORAGE_LOCAL_PATH=data/uploads  # default local path
# For MinIO:
# STORAGE_TYPE=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=xcai
MINIO_USE_SSL=false

# JWT
JWT_SECRET=change-this-to-a-secure-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMS (Aliyun)
SMS_PROVIDER=mock
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_CODE_LENGTH=6
SMS_CODE_TTL=300
SMS_CODE_COOLDOWN=60
SMS_MAX_SEND_PER_DAY=10

# WeChat
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# QQ
QQ_APP_ID=
QQ_APP_KEY=
